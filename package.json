{
  "name": "rex-widget",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "deps:check": "manypkg check",
    "deps:fix": "manypkg fix",
    "change": "changeset",
    "version": "changeset version",
    "postversion": "npm run build",
    "prerelease": "npm run build",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@manypkg/cli": "^0.25.1",
    "nano-staged": "^0.8.0",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,mts,cts}": [
      "biome check --write"
    ],
    "pnpm-lock.yaml": "sh -c 'pnpm dedupe --check'"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
}
